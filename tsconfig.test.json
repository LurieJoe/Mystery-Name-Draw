{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": ".tmp-test"
  },
  "include": [
    "src/draw/**/*.ts",
    "src/exchange/restrictionNotices.ts",
    "src/exchange/types.ts",
    "src/router.ts",
    "src/api/rpc.ts",
    "src/exchange/remote.ts",
    "src/api/config.ts",
    "src/exchange/restrictionWindow.ts",
    "src/exchange/restrictionWindow.test.ts",
    "src/email/templates.ts",
    "src/email/templates.test.ts"
  ]
}

# Both are public: they are compiled into the JavaScript every visitor
# downloads. The publishable key reaches nothing on its own, because
# every function in the schema demands a token it does not have.
#
# Copy this to .env.local, which is not committed.
#
# The secret key (sb_secret_...) belongs in neither file, nor in a
# repository secret, nor anywhere a browser can see.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
